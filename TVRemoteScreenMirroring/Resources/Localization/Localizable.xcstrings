    "capability.note.wakeNeedsMulticastEntitlement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on over Wi‑Fi needs a network permission from Apple that this version may not have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encender por Wi‑Fi requiere un permiso de red de Apple que esta versión puede no tener."
          }
