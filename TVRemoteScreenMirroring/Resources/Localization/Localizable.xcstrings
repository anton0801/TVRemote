        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы ничего не списали. Попробуйте снова или проверьте способ оплаты в Apple Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
