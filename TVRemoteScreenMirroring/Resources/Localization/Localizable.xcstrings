    "discovery.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the TV is on, on the same Wi‑Fi, and not on a guest network. A VPN on the iPhone can also block the search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la TV esté encendida, en el mismo Wi‑Fi y no en una red de invitados. Una VPN en el iPhone también puede bloquear la búsqueda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что телевизор включён, находится в той же сети Wi‑Fi и не в гостевой. VPN на iPhone тоже может мешать поиску."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob der Fernseher an, im selben WLAN und nicht im Gastnetz ist. Auch ein VPN auf dem iPhone kann die Suche blockieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le téléviseur est allumé, sur le même Wi‑Fi et pas sur un réseau invité. Un VPN sur l’iPhone peut aussi bloquer la recherche."
          }
        }
      }
    },
