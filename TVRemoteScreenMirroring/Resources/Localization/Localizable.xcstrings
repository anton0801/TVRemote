    "help.appsNotLaunching.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app opens a service that is installed on your TV. It doesn’t provide the service or its subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app abre un servicio instalado en tu TV. No proporciona el servicio ni su suscripción."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение открывает сервис, установленный на телевизоре. Сам сервис и подписку на него оно не предоставляет."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App öffnet einen auf dem Fernseher installierten Dienst. Den Dienst oder dessen Abo stellt sie nicht bereit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ouvre un service installé sur votre téléviseur. Elle ne fournit ni le service ni son abonnement."
          }
        }
      }
    },
    "help.appsNotLaunching.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the app is installed on the TV and opens with the TV’s own remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la app esté instalada en la TV y se abra con su mando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что приложение установлено на телевизоре и открывается его пультом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob die App am Fernseher installiert ist und sich mit der TV-Fernbedienung öffnen lässt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que l’app est installée sur le téléviseur et s’ouvre avec sa télécommande."
          }
        }
      }
    },
    "help.appsNotLaunching.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some services aren’t available in every country or on every TV model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos servicios no están disponibles en todos los países ni en todos los modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые сервисы доступны не во всех странах и не на всех моделях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Dienste gibt es nicht in jedem Land oder auf jedem Modell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains services ne sont pas disponibles dans tous les pays ni sur tous les modèles."
          }
        }
      }
    },
    "help.appsNotLaunching.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Request sent” means the TV got the command but didn’t confirm the app opened. Look at the TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solicitud enviada» significa que la TV recibió la orden pero no confirmó que la app se abriera. Mira la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Команда отправлена» означает, что телевизор её получил, но не подтвердил открытие. Посмотрите на экран."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Anfrage gesendet“ heißt: Der Fernseher hat den Befehl erhalten, das Öffnen aber nicht bestätigt. Schau auf den Fernseher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Demande envoyée » signifie que le téléviseur a reçu la commande sans confirmer l’ouverture. Regardez l’écran."
          }
        }
      }
    },
    "help.appsNotLaunching.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it doesn’t open, press Home and start it from the TV’s app list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se abre, pulsa Inicio y ábrela desde la lista de apps de la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не открылось, нажмите «Домой» и запустите приложение из списка на ТВ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet sie sich nicht, drücke Home und starte sie aus der App-Liste des Fernsehers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elle ne s’ouvre pas, appuyez sur Accueil et lancez-la depuis la liste des apps."
          }
        }
      }
    },
    "help.appsNotLaunching.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ or another app won’t open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ u otra app no se abre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не открывается Netflix, Disney+ или другое приложение"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ oder eine andere App öffnet nicht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netflix, Disney+ ou une autre app ne s’ouvre pas"
          }
        }
      }
    },
