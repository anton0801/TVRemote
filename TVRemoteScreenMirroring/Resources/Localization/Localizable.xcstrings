          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander un remboursement"
          }
        }
      }
    },
    "help.search.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing found. Try other words or contact us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin resultados. Prueba otras palabras o escríbenos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не найдено. Попробуйте другие слова или напишите нам."
          }
        },
        "de": {
