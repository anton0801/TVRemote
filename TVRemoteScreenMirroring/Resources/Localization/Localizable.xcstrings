    "paywall.lifetime.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one-time purchase unlocks the app’s features permanently. It doesn’t cancel an existing subscription — to stop its future payments, turn off auto-renew in your Apple subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pago único desbloquea las funciones de la app de forma permanente. No cancela una suscripción existente: para detener sus pagos futuros, desactiva la renovación automática en tus suscripciones de Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка открывает бессрочный доступ в приложении. Она не отменяет действующую подписку. Чтобы прекратить её будущие списания, отключите автопродление в настройках Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Einmalkauf schaltet die App-Funktionen dauerhaft frei. Ein bestehendes Abo wird nicht gekündigt – deaktiviere dessen automatische Verlängerung in deinen Apple-Abos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat unique débloque durablement les fonctions de l’app. Il n’annule pas un abonnement existant : pour arrêter ses paiements futurs, désactivez le renouvellement automatique dans vos abonnements Apple."
          }
        }
      }
    },
