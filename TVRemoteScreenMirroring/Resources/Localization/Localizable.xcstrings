    "error.net-003.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the TV is on and on the same network. Guest networks and VPNs can hide devices from each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la TV esté encendida y en la misma red. Las redes de invitados y las VPN pueden ocultar los dispositivos entre sí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что телевизор включён и находится в той же сети. Гостевая сеть и VPN могут скрывать устройства друг от друга."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass der Fernseher eingeschaltet und im selben Netzwerk ist. Gastnetzwerke und VPNs können Geräte voneinander verbergen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le téléviseur est allumé et sur le même réseau. Les réseaux invités et les VPN peuvent masquer les appareils entre eux."
          }
        }
      }
    },
    "error.net-003.title": {
