    "keyboard.privacyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed text goes only to your TV. It isn’t saved or sent to analytics. Passwords may not work in every TV app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto solo va a tu TV. No se guarda ni se envía a analíticas. Puede que las contraseñas no funcionen en todas las apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст отправляется только на телевизор. Он не сохраняется и не попадает в аналитику. Пароли могут работать не во всех приложениях ТВ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Getippter Text geht nur an deinen Fernseher. Er wird weder gespeichert noch analysiert. Passwörter funktionieren nicht in jeder TV-App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte va uniquement à votre téléviseur. Il n’est ni enregistré ni envoyé aux statistiques. Les mots de passe peuvent ne pas fonctionner dans toutes les apps."
          }
        }
      }
    },
