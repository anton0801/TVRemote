    "error.app-001.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app may not be installed or available in your region. Install or check it on the TV itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la app no esté instalada o disponible en tu región. Instálala o revísala en la propia TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, приложение не установлено или недоступно в вашем регионе. Установите или проверьте его на самом телевизоре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
