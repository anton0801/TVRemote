    "mirroring.unsupportedPlatform": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our Screen Mirroring isn’t available for this TV because it has no web browser we can use. Remote control and other supported features still work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestra duplicación no está disponible para esta TV porque no tiene un navegador utilizable. El mando y otras funciones compatibles siguen funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наша трансляция экрана недоступна для этого телевизора: у него нет подходящего браузера. Пульт и другие поддерживаемые функции работают."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere Spiegelung ist für diesen Fernseher nicht verfügbar, da er keinen nutzbaren Webbrowser hat. Fernbedienung und andere Funktionen bleiben nutzbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre recopie n’est pas disponible pour ce téléviseur, faute de navigateur utilisable. La télécommande et les autres fonctions prises en charge fonctionnent."
          }
        }
      }
