        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы продолжим использовать последний подтверждённый доступ и проверим его снова автоматически."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nutzen weiter deinen zuletzt bestätigten Zugriff und prüfen automatisch erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous continuons d’utiliser votre dernier accès vérifié et revérifierons automatiquement."
          }
        }
      }
    },
    "error.iap-006.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check your access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar tu acceso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить доступ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff konnte nicht geprüft werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier votre accès"
          }
        }
      }
    },
    "error.med-001.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t find a media receiver on this TV. Some TVs need media sharing (DLNA) turned on in their settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos un receptor multimedia en esta TV. Algunas TV requieren activar el uso compartido (DLNA) en sus ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телевизоре не найден медиаприёмник. На некоторых моделях нужно включить общий доступ к медиа (DLNA) в настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Fernseher wurde kein Medienempfänger gefunden. Bei manchen Modellen muss die Medienfreigabe (DLNA) aktiviert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun récepteur multimédia trouvé sur ce téléviseur. Certains modèles exigent d’activer le partage multimédia (DLNA)."
          }
        }
      }
    },
    "error.med-001.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TV can’t receive photos or videos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no puede recibir fotos ni vídeos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не принимает фото и видео"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernseher kann keine Fotos oder Videos empfangen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur ne peut pas recevoir de photos ou vidéos"
          }
        }
      }
    },
    "error.med-002.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV can’t play this file. Try another photo or a video recorded on iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no puede reproducir este archivo. Prueba con otra foto o con un vídeo grabado con el iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не может воспроизвести этот файл. Выберите другое фото или видео, снятое на iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher kann diese Datei nicht abspielen. Versuche ein anderes Foto oder ein mit dem iPhone aufgenommenes Video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur ne peut pas lire ce fichier. Essayez une autre photo ou une vidéo filmée avec l’iPhone."
          }
        }
      }
    },
    "error.med-002.title": {
