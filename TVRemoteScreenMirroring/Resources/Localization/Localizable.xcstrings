    "remote.more.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls depend on your TV. Keys your TV doesn’t accept are hidden. Wake requires network standby."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles dependen de tu TV. Las teclas que tu TV no acepta se ocultan. El encendido requiere espera en red."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор кнопок зависит от телевизора: неподдерживаемые скрыты. Для включения нужен сетевой режим ожидания."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuerung hängt von deinem TV ab. Tasten, die er nicht annimmt, sind ausgeblendet. Einschalten erfordert Netzwerk-Standby."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes dépendent de votre TV. Les touches non acceptées sont masquées. L’allumage nécessite la veille réseau."
          }
        }
      }
