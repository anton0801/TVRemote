    "change.yearly.savings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per year — %2$@ less than 12 payments of %3$@ (about %4$lld%% savings)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ al año: %2$@ menos que 12 pagos de %3$@ (un ahorro de aprox. el %4$lld %%)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ в год — на %2$@ меньше, чем 12 платежей по %3$@ (экономия около %4$lld%%)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pro Jahr – %2$@ weniger als 12 Zahlungen à %3$@ (ca. %4$lld %% Ersparnis)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ par an — %2$@ de moins que 12 paiements de %3$@ (environ %4$lld %% d’économie)."
          }
        }
      }
    },
