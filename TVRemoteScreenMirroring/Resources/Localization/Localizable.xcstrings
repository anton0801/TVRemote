    "capability.note.wakeNeedsMacAddress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV didn’t share the information needed to turn it on remotely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no compartió la información necesaria para encenderla a distancia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не сообщил данные, нужные для удалённого включения."
          }
        },
        "de": {
