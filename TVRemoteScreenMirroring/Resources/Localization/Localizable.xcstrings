    "help.mediaNotShowing.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV loads the selected file directly from your iPhone over Wi‑Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV carga el archivo seleccionado directamente desde el iPhone por Wi‑Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор загружает выбранный файл прямо с iPhone по Wi‑Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher lädt die gewählte Datei direkt vom iPhone über WLAN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur charge le fichier choisi directement depuis l’iPhone via Wi‑Fi."
          }
        }
      }
    },
    "help.mediaNotShowing.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the app open while showing photos or videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la app abierta mientras muestras fotos o vídeos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывайте приложение во время показа фото или видео."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die App geöffnet, während Fotos oder Videos gezeigt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l’app ouverte pendant l’affichage des photos ou vidéos."
          }
        }
      }
    },
    "help.mediaNotShowing.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some TVs need media sharing (DLNA) enabled in their network settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas TV necesitan tener activado el uso compartido (DLNA) en sus ajustes de red."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На некоторых телевизорах нужно включить общий доступ к медиа (DLNA) в сетевых настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Fernseher brauchen aktivierte Medienfreigabe (DLNA) in den Netzwerkeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains téléviseurs exigent d’activer le partage multimédia (DLNA) dans leurs réglages réseau."
          }
        }
      }
    },
    "help.mediaNotShowing.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items in iCloud are downloaded first; this needs internet access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de iCloud se descargan primero; esto requiere internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы из iCloud сначала загружаются — для этого нужен интернет."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte aus iCloud werden zuerst geladen; dafür ist Internet nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments iCloud sont d’abord téléchargés ; il faut un accès Internet."
          }
        }
      }
    },
    "help.mediaNotShowing.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a video format isn’t supported, the app converts it when possible; very long videos take more time and space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un formato de vídeo no es compatible, la app lo convierte cuando es posible; los vídeos largos necesitan más tiempo y espacio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если формат видео не поддерживается, приложение по возможности его конвертирует; длинные видео требуют больше времени и места."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird ein Videoformat nicht unterstützt, konvertiert die App es wenn möglich; lange Videos brauchen mehr Zeit und Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un format vidéo n’est pas pris en charge, l’app le convertit si possible ; les longues vidéos demandent plus de temps et d’espace."
          }
        }
      }
    },
    "help.mediaNotShowing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos or videos don’t show"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se muestran fotos o vídeos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не показываются фото или видео"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos oder Videos werden nicht angezeigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos ou vidéos ne s’affichent pas"
          }
        }
      }
    },
    "help.mirroringProblem.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our Screen Mirroring shows your screen in the TV’s web browser over Wi‑Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestra duplicación muestra la pantalla en el navegador de la TV por Wi‑Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наша трансляция показывает экран в браузере телевизора через Wi‑Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere Spiegelung zeigt deinen Bildschirm im Webbrowser des Fernsehers über WLAN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre recopie affiche votre écran dans le navigateur du téléviseur via Wi‑Fi."
          }
        }
      }
    },
    "help.mirroringProblem.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It works on TVs with a web browser (many Samsung and LG models). Android TV and Google TV usually have no browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona en TV con navegador (muchos modelos Samsung y LG). Android TV y Google TV no suelen tener navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает на телевизорах с браузером (многие модели Samsung и LG). На Android TV и Google TV браузера обычно нет."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert auf Fernsehern mit Webbrowser (viele Samsung- und LG-Modelle). Android TV und Google TV haben meist keinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur les téléviseurs dotés d’un navigateur (nombreux Samsung et LG). Android TV et Google TV n’en ont généralement pas."
          }
        }
      }
    },
    "help.mirroringProblem.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound isn’t sent in this version — it plays on the iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta versión no se envía el sonido; se reproduce en el iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии звук не передаётся — он играет на iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Version wird kein Ton übertragen – er läuft auf dem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son n’est pas transmis dans cette version : il est joué sur l’iPhone."
          }
        }
      }
    },
    "help.mirroringProblem.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A strong Wi‑Fi signal reduces delay. Move closer to the router or use 5 GHz if your router offers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una buena señal Wi‑Fi reduce el retraso. Acércate al router o usa 5 GHz si está disponible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хороший сигнал Wi‑Fi уменьшает задержку. Подойдите ближе к роутеру или используйте 5 ГГц, если он есть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein starkes WLAN-Signal verringert die Verzögerung. Geh näher an den Router oder nutze 5 GHz, falls verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bon signal Wi‑Fi réduit le délai. Rapprochez-vous du routeur ou utilisez le 5 GHz s’il est disponible."
          }
        }
      }
    },
    "help.mirroringProblem.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming apps often block screen capture (black picture). Open the service directly on the TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de streaming suelen bloquear la captura (imagen negra). Abre el servicio en la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стриминговые приложения часто блокируют захват экрана (чёрная картинка). Откройте сервис прямо на ТВ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming-Apps blockieren oft die Aufnahme (schwarzes Bild). Öffne den Dienst direkt am Fernseher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps de streaming bloquent souvent la capture (image noire). Ouvrez le service sur le téléviseur."
          }
        }
      }
    },
    "help.mirroringProblem.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Mirroring doesn’t work, lags or has no sound"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duplicación no funciona, va lenta o no tiene sonido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляция не работает, тормозит или без звука"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelung geht nicht, ruckelt oder ohne Ton"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopie ne fonctionne pas, saccade ou est sans son"
          }
        }
      }
    },
    "help.paidNoAccess.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases belong to the Apple Account that made them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras pertenecen a la cuenta de Apple con la que se hicieron."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки привязаны к Apple Account, с которого они сделаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe gehören zum Apple Account, mit dem sie getätigt wurden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats sont liés au compte Apple qui les a effectués."
          }
        }
      }
    },
    "help.paidNoAccess.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Restore Purchases below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Restaurar compras abajo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Восстановить покупки» ниже."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten auf „Käufe wiederherstellen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Restaurer les achats ci-dessous."
          }
        }
      }
    },
    "help.paidNoAccess.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check you’re signed in with the same Apple Account you used to buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que usas la misma cuenta de Apple con la que compraste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что вы вошли с тем же Apple Account, с которого покупали."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob du mit demselben Apple Account angemeldet bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que vous êtes connecté avec le même compte Apple que pour l’achat."
          }
        }
      }
    },
    "help.paidNoAccess.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A purchase waiting for approval (Ask to Buy) starts after it’s approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra pendiente de aprobación («Solicitar la compra») se activa al aprobarse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка, ожидающая одобрения («Попросить купить»), активируется после одобрения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf, der auf Genehmigung wartet („Kaufanfrage“), startet nach der Freigabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat en attente d’approbation démarre une fois approuvé."
          }
        }
      }
    },
    "help.paidNoAccess.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t buy again. If access is still missing, contact support — include the purchase date, not payment details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No vuelvas a comprar. Si sigues sin acceso, contacta con soporte indicando la fecha de compra, no los datos de pago."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не покупайте повторно. Если доступа нет, напишите в поддержку и укажите дату покупки, но не платёжные данные."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufe nicht erneut. Fehlt der Zugriff weiterhin, kontaktiere den Support mit dem Kaufdatum – ohne Zahlungsdaten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’achetez pas à nouveau. Si l’accès manque toujours, contactez l’assistance avec la date d’achat, sans données de paiement."
          }
        }
      }
    },
    "help.paidNoAccess.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I paid but don’t have access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagué pero no tengo acceso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплатил, но доступа нет"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezahlt, aber kein Zugriff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai payé mais je n’ai pas accès"
          }
        }
      }
    },
    "help.privacy.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote commands, typed text, photos and your screen stay on your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las órdenes, el texto, las fotos y la pantalla se quedan en tu red local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды, текст, фото и изображение экрана остаются в вашей локальной сети."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle, getippter Text, Fotos und dein Bildschirm bleiben in deinem lokalen Netzwerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandes, texte saisi, photos et écran restent sur votre réseau local."
          }
        }
      }
    },
    "help.privacy.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage analytics and crash reports are off until you turn them on in Settings → Privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las analíticas y los informes de fallos están desactivados hasta que los actives en Ajustes → Privacidad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналитика и отчёты о сбоях выключены, пока вы не включите их в Настройках → Конфиденциальность."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungsanalyse und Absturzberichte sind aus, bis du sie unter Einstellungen → Datenschutz aktivierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques et rapports de plantage sont désactivés tant que vous ne les activez pas dans Réglages → Confidentialité."
          }
        }
      }
    },
    "help.privacy.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We never collect typed text, TV names, network addresses, photos or screen content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca recopilamos texto escrito, nombres de TV, direcciones de red, fotos ni el contenido de la pantalla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы никогда не собираем набранный текст, имена ТВ, сетевые адреса, фото или содержимое экрана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erfassen nie getippten Text, TV-Namen, Netzwerkadressen, Fotos oder Bildschirminhalte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne collectons jamais le texte saisi, les noms de téléviseurs, les adresses réseau, les photos ni l’écran."
          }
        }
      }
    },
    "help.privacy.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical details are added to a support message only if you switch them on and send the message yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles técnicos solo se añaden a un mensaje si los activas y lo envías tú."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Технические сведения добавляются к обращению, только если вы их включите и сами отправите сообщение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Technische Details werden nur angehängt, wenn du sie aktivierst und die Nachricht selbst sendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails techniques ne sont joints que si vous les activez et envoyez vous-même le message."
          }
        }
      }
    },
    "help.privacy.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To ask about or delete data you sent us, contact support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para consultar o eliminar datos que nos enviaste, contacta con soporte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы узнать о переданных данных или удалить их, напишите в поддержку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Auskunft oder Löschung gesendeter Daten kontaktiere den Support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour consulter ou supprimer les données envoyées, contactez l’assistance."
          }
        }
      }
    },
    "help.privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy and diagnostic data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidad y datos de diagnóstico"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиденциальность и диагностика"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz und Diagnosedaten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité et diagnostics"
          }
        }
      }
    },
    "help.quickFix.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try these steps to fix it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba estos pasos para resolverlo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте эти шаги"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere diese Schritte aus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez ces étapes"
          }
        }
      }
    },
    "help.refund.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store purchases are refunded by Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los reembolsos de compras del App Store los gestiona Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат покупок в App Store выполняет Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-Käufe erstattet Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats App Store sont remboursés par Apple."
          }
        }
      }
    },
    "help.refund.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are sent to Apple at reportaproblem.apple.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes se envían a Apple en reportaproblem.apple.com."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос отправляется в Apple на сайте reportaproblem.apple.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen gehen über reportaproblem.apple.com an Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes sont envoyées à Apple sur reportaproblem.apple.com."
          }
        }
      }
    },
    "help.refund.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple decides on refunds; we can’t approve or guarantee them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple decide sobre los reembolsos; nosotros no podemos aprobarlos ni garantizarlos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решение принимает Apple; мы не можем одобрить или гарантировать возврат."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple entscheidet über Erstattungen; wir können sie weder genehmigen noch garantieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple décide des remboursements ; nous ne pouvons ni les approuver ni les garantir."
          }
        }
      }
    },
    "help.refund.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a refund is granted, the related access ends. Other valid purchases keep working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se concede, el acceso asociado termina. Las demás compras válidas siguen funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если возврат одобрен, связанный доступ прекращается. Другие действующие покупки продолжают работать."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird erstattet, endet der zugehörige Zugriff. Andere gültige Käufe bleiben aktiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas de remboursement, l’accès associé prend fin. Les autres achats valides continuent de fonctionner."
          }
        }
      }
    },
    "help.refund.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a refund"
          }
        },
        "es": {
