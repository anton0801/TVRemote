    "mirroring.howItWorks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you start, iOS asks for permission to record the screen. We then open a private page in the TV’s web browser that shows your screen over your Wi‑Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al empezar, iOS pide permiso para grabar la pantalla. Después abrimos una página privada en el navegador de la TV que muestra tu pantalla por tu Wi‑Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При запуске iOS запросит разрешение на запись экрана. Затем мы откроем в браузере телевизора закрытую страницу, которая показывает ваш экран через Wi‑Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Start fragt iOS nach der Erlaubnis zur Bildschirmaufnahme. Dann öffnen wir im Webbrowser des Fernsehers eine private Seite, die deinen Bildschirm über dein WLAN zeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au démarrage, iOS demande l’autorisation d’enregistrer l’écran. Nous ouvrons ensuite une page privée dans le navigateur du téléviseur qui affiche votre écran via le Wi‑Fi."
          }
        }
      }
    },
    "mirroring.latency": {
      "extractionState": "manual",
      "localizations": {
