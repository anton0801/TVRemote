          }
        }
      }
    },
    "help.stillNeedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still not working? Send us a message — you can add technical details if you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigue sin funcionar? Escríbenos; puedes añadir detalles técnicos si quieres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё не работает? Напишите нам — при желании можно добавить технические сведения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klappt es noch nicht? Schreib uns – auf Wunsch mit technischen Details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours un problème ? Écrivez-nous ; vous pouvez ajouter des détails techniques si vous le souhaitez."
          }
        }
      }
    },
    "help.textNotWorking.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text from the iPhone goes into the text field that is currently selected on the TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del iPhone va al campo de texto seleccionado en la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст с iPhone попадает в поле ввода, выбранное на телевизоре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text vom iPhone landet im aktuell ausgewählten Textfeld am Fernseher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte de l’iPhone va dans le champ de texte sélectionné sur le téléviseur."
          }
        }
      }
    },
    "help.textNotWorking.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the TV, open a search box so its on-screen keyboard appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la TV, abre un cuadro de búsqueda para que aparezca su teclado en pantalla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте на телевизоре поле поиска, чтобы появилась экранная клавиатура."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne am Fernseher ein Suchfeld, damit die Bildschirmtastatur erscheint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le téléviseur, ouvrez une zone de recherche pour afficher son clavier."
          }
        }
      }
    },
    "help.textNotWorking.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps (for example some streaming apps) use their own keyboard and don’t accept text from phones. Use the arrow buttons there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas apps (p. ej. ciertas apps de streaming) usan su propio teclado y no aceptan texto del teléfono. Usa las flechas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые приложения (например, стриминговые) используют свою клавиатуру и не принимают текст с телефона. Используйте стрелки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Apps (z. B. einige Streaming-Apps) nutzen eine eigene Tastatur und nehmen keinen Text an. Nutze dort die Pfeiltasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines apps (dont des apps de streaming) ont leur propre clavier et refusent le texte du téléphone. Utilisez les flèches."
          }
        }
      }
    },
    "help.textNotWorking.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On some Samsung TVs, type the whole text on the iPhone first, then tap Send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En algunas TV Samsung, escribe todo el texto en el iPhone y luego toca Enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На некоторых телевизорах Samsung сначала наберите весь текст на iPhone, затем нажмите «Отправить»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei manchen Samsung-Fernsehern tippst du zuerst den ganzen Text und tippst dann auf „Senden“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur certains téléviseurs Samsung, tapez tout le texte sur l’iPhone puis touchez Envoyer."
          }
        }
      }
    },
    "help.textNotWorking.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Special characters depend on the TV: if a letter doesn’t appear, the TV field may not accept it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los caracteres especiales dependen de la TV: si una letra no aparece, puede que el campo no la acepte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Специальные символы зависят от телевизора: если буква не появилась, поле может её не принимать."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonderzeichen hängen vom Fernseher ab: Erscheint ein Buchstabe nicht, akzeptiert das Feld ihn eventuell nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caractères spéciaux dépendent du téléviseur : si une lettre n’apparaît pas, le champ ne l’accepte peut-être pas."
          }
        }
      }
    },
    "help.textNotWorking.title": {
