    "error.iap-003.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You weren’t charged by us. Try again, or check your payment method in your Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos realizado ningún cargo. Inténtalo de nuevo o revisa el método de pago de tu cuenta de Apple."
