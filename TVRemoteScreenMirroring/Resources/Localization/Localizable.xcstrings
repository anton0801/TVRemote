          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage insuffisant"
          }
        }
      }
    },
    "error.med-006.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV didn’t start playing. Try again, or check that nothing else is using the TV’s media player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no empezó a reproducir. Inténtalo de nuevo o comprueba que nada más esté usando su reproductor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не начал воспроизведение. Попробуйте снова или проверьте, не занят ли его плеер."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher hat nicht mit der Wiedergabe begonnen. Versuche es erneut oder prüfe, ob der Player belegt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur n’a pas lancé la lecture. Réessayez ou vérifiez que son lecteur n’est pas déjà utilisé."
          }
        }
      }
    },
    "error.med-006.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback didn’t start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción no empezó"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение не началось"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe hat nicht gestartet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture n’a pas démarré"
          }
        }
      }
    },
    "error.mir-001.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our Screen Mirroring needs the TV’s web browser, which this TV doesn’t offer or didn’t open. Photos and videos may still work on this TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestra duplicación de pantalla necesita el navegador de la TV, que esta TV no ofrece o no abrió. Puede que las fotos y los vídeos sí funcionen en esta TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для нашей трансляции нужен браузер телевизора, а на этом телевизоре его нет или он не открылся. Фото и видео на этом телевизоре могут работать."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere Spiegelung braucht den Webbrowser des Fernsehers, den dieses Gerät nicht bietet oder nicht geöffnet hat. Fotos und Videos funktionieren eventuell trotzdem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre recopie nécessite le navigateur du téléviseur, absent ou non ouvert ici. Les photos et vidéos peuvent tout de même fonctionner sur ce téléviseur."
          }
        }
      }
    },
    "error.mir-001.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring receiver not available"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Receptor de duplicación no disponible"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приёмник трансляции недоступен"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelungsempfänger nicht verfügbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récepteur de recopie indisponible"
          }
        }
      }
    },
    "error.mir-002.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the TV’s web browser once manually, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una vez el navegador de la TV manualmente y vuelve a intentarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте браузер на телевизоре вручную один раз и попробуйте снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Webbrowser des Fernsehers einmal manuell und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une fois le navigateur du téléviseur manuellement, puis réessayez."
          }
        }
      }
    },
    "error.mir-002.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TV browser didn’t open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se abrió el navegador de la TV"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузер телевизора не открылся"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-Browser hat sich nicht geöffnet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le navigateur du téléviseur ne s’est pas ouvert"
          }
        }
      }
    },
    "error.mir-003.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen recording was ended by the system. Start mirroring again when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema finalizó la grabación de pantalla. Vuelve a iniciar la duplicación cuando quieras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система завершила запись экрана. Начните трансляцию снова, когда будете готовы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System hat die Bildschirmaufnahme beendet. Starte die Spiegelung erneut, wenn du bereit bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système a arrêté l’enregistrement de l’écran. Relancez la recopie quand vous êtes prêt."
          }
        }
      }
    },
    "error.mir-003.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring stopped by iOS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS detuvo la duplicación"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS остановила трансляцию"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat die Spiegelung beendet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a arrêté la recopie"
          }
        }
      }
    },
    "error.mir-004.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring stopped because the TV or Wi‑Fi disconnected. Check the network and start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duplicación se detuvo porque la TV o el Wi‑Fi se desconectó. Revisa la red y vuelve a empezar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляция остановлена: отключился телевизор или Wi‑Fi. Проверьте сеть и начните снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spiegelung wurde beendet, weil Fernseher oder WLAN getrennt wurden. Prüfe das Netzwerk und starte neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopie s’est arrêtée car le téléviseur ou le Wi‑Fi s’est déconnecté. Vérifiez le réseau et recommencez."
          }
        }
      }
    },
    "error.mir-004.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network connection lost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión de red"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевое соединение потеряно"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkverbindung unterbrochen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion réseau perdue"
          }
        }
      }
    },
    "error.mir-005.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming apps often block screen capture, so the TV may show a black picture. Open the service directly on the TV instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de streaming suelen bloquear la captura de pantalla y la TV puede verse en negro. Abre el servicio directamente en la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стриминговые сервисы часто запрещают захват экрана, поэтому на телевизоре может быть чёрный экран. Откройте сервис прямо на телевизоре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming-Apps blockieren oft die Bildschirmaufnahme, daher kann das Bild schwarz sein. Öffne den Dienst direkt am Fernseher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps de streaming bloquent souvent la capture d’écran : l’image peut être noire. Ouvrez plutôt le service sur le téléviseur."
          }
        }
      }
    },
    "error.mir-005.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected content"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido protegido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённый контент"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützte Inhalte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu protégé"
          }
        }
      }
    },
    "error.mir-006.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring stopped to protect your iPhone. Let it cool down, then start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duplicación se detuvo para proteger el iPhone. Deja que se enfríe y vuelve a empezar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляция остановлена, чтобы защитить iPhone. Дайте ему остыть и начните снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spiegelung wurde zum Schutz deines iPhone beendet. Lass es abkühlen und starte neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopie s’est arrêtée pour protéger votre iPhone. Laissez-le refroidir, puis recommencez."
          }
        }
      }
    },
    "error.mir-006.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
