    "error.iap-002.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store is waiting for approval (for example Ask to Buy). Access starts automatically once it’s approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store espera una aprobación (por ejemplo, «Solicitar la compra»). El acceso empezará automáticamente al aprobarse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ждёт подтверждения (например, «Попросить купить»). Доступ откроется автоматически после одобрения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store wartet auf eine Genehmigung (z. B. „Kaufanfrage“). Der Zugriff startet automatisch nach der Freigabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store attend une approbation (par exemple « Autorisation d’achat »). L’accès démarrera automatiquement une fois approuvé."
          }
        }
      }
    },
