    "bonus.discount.firstMonthOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The discount applies to the first month of the monthly plan only — not to renewals, the yearly plan or lifetime access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descuento se aplica solo al primer mes del plan mensual, no a las renovaciones, al plan anual ni al acceso de por vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидка действует только на первый месяц месячного тарифа — не на продления, годовой тариф или доступ навсегда."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rabatt gilt nur für den ersten Monat des Monatstarifs – nicht für Verlängerungen, den Jahrestarif oder den dauerhaften Zugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réduction ne vaut que pour le premier mois de l’offre mensuelle, pas pour les renouvellements, l’annuel ni l’accès à vie."
          }
        }
      }
    },
