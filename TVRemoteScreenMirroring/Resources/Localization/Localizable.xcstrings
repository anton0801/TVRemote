    "error.net-004.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV didn’t respond. It may be off, in deep standby, or on another network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no respondió. Puede que esté apagada, en reposo profundo o en otra red."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не ответил. Возможно, он выключен, в глубоком режиме ожидания или в другой сети."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher hat nicht geantwortet. Er ist eventuell aus, im tiefen Standby oder in einem anderen Netzwerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur n’a pas répondu. Il est peut-être éteint, en veille profonde ou sur un autre réseau."
          }
        }
      }
