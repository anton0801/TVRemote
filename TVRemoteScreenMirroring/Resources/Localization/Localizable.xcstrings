    "privacy.analytics.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps us see which features work (Google Analytics for Firebase). Never includes typed text, TV names, addresses, photos or screen content. Off until you turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos ayuda a ver qué funciones funcionan (Google Analytics for Firebase). Nunca incluye texto, nombres de TV, direcciones, fotos ni pantalla. Desactivado hasta que lo actives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогает понять, какие функции работают (Google Analytics for Firebase). Никогда не содержит текст, имена ТВ, адреса, фото или экран. Выключено, пока вы не включите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt uns, welche Funktionen funktionieren (Google Analytics for Firebase). Nie mit Text, TV-Namen, Adressen, Fotos oder Bildschirm. Aus, bis du es aktivierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous aide à savoir quelles fonctions marchent (Google Analytics for Firebase). N’inclut jamais texte, noms de téléviseurs, adresses, photos ni écran. Désactivé jusqu’à activation."
          }
        }
      }
    },
