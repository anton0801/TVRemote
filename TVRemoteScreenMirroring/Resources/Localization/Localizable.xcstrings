    "capability.note.mirroringNeedsBrowser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the TV’s web browser as receiver; latency is higher than a cable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el navegador de la TV como receptor; la latencia es mayor que con cable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приёмник — браузер телевизора; задержка выше, чем по кабелю."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt den Webbrowser des Fernsehers als Empfänger; die Verzögerung ist höher als per Kabel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le navigateur du téléviseur comme récepteur ; la latence est supérieure à un câble."
          }
        }
      }
    },
    "capability.note.mirroringNoBrowserOnPlatform": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This TV has no web browser we can use, so our Screen Mirroring isn’t available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta TV no tiene un navegador que podamos usar, así que nuestra duplicación no está disponible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телевизоре нет подходящего браузера, поэтому наша трансляция экрана недоступна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Fernseher hat keinen nutzbaren Webbrowser, daher ist unsere Spiegelung nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléviseur n’a pas de navigateur utilisable : notre recopie n’est pas disponible."
          }
        }
      }
    },
