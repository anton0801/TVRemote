    "support.diagnostics.excluded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never included: IP or MAC addresses, Wi‑Fi name, TV names, serial numbers, pairing keys, typed text, screen content, photos, receipts or full transaction IDs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se incluye: direcciones IP o MAC, nombre del Wi‑Fi, nombres de TV, números de serie, claves de vinculación, texto escrito, pantalla, fotos, recibos ni IDs completos de transacción."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не включаются: IP- и MAC-адреса, имя Wi‑Fi, имена ТВ, серийные номера, ключи сопряжения, набранный текст, содержимое экрана, фото, чеки и полные ID транзакций."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie enthalten: IP- oder MAC-Adressen, WLAN-Name, TV-Namen, Seriennummern, Kopplungsschlüssel, getippter Text, Bildschirminhalt, Fotos, Belege oder vollständige Transaktions-IDs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais inclus : adresses IP ou MAC, nom du Wi‑Fi, noms des téléviseurs, numéros de série, clés d’association, texte saisi, écran, photos, reçus ni identifiants complets de transaction."
          }
        }
      }
    },
    "support.diagnostics.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Includes app and iOS version, language, TV platform, error codes and recent connection states — no names, addresses, typed text or payment data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Incluye versión de la app y de iOS, idioma, plataforma de la TV, códigos de error y estados recientes de conexión; sin nombres, direcciones, texto ni datos de pago."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Содержит версии приложения и iOS, язык, платформу ТВ, коды ошибок и недавние состояния подключения — без имён, адресов, текста и платёжных данных."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Enthält App- und iOS-Version, Sprache, TV-Plattform, Fehlercodes und letzte Verbindungszustände – keine Namen, Adressen, Texte oder Zahlungsdaten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Comprend version de l’app et d’iOS, langue, plateforme du téléviseur, codes d’erreur et états de connexion récents, sans noms, adresses, texte ni données de paiement."
          }
        }
      }
    },
