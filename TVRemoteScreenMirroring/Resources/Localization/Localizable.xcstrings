            "state": "translated",
            "value": "iPhone ist zu warm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone est trop chaud"
          }
        }
      }
    },
    "error.mir-007.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t set up the connection on this network. Check Wi‑Fi and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos establecer la conexión en esta red. Comprueba el Wi‑Fi e inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить соединение в этой сети. Проверьте Wi‑Fi и попробуйте снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung konnte in diesem Netzwerk nicht aufgebaut werden. Prüfe das WLAN und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’établir la connexion sur ce réseau. Vérifiez le Wi‑Fi et réessayez."
          }
        }
      }
    },
    "error.mir-007.title": {
