    "error.pair-002.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation on the TV timed out. Keep the TV remote nearby and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmación en la TV caducó. Ten a mano el mando de la TV e inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время подтверждения на телевизоре истекло. Держите пульт телевизора рядом и попробуйте снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestätigung am Fernseher ist abgelaufen. Halte die TV-Fernbedienung bereit und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmation sur le téléviseur a expiré. Gardez la télécommande du téléviseur à portée de main et réessayez."
          }
        }
      }
    },
    "error.pair-002.title": {
