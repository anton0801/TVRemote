    "support.form.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form is run by an external service. Your message text is copied so you can paste it; nothing is sent until you submit the form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formulario lo gestiona un servicio externo. Copiamos el texto para que lo pegues; no se envía nada hasta que envíes el formulario."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма работает на внешнем сервисе. Текст сообщения будет скопирован для вставки; ничего не отправится, пока вы не отправите форму."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Formular wird von einem externen Dienst betrieben. Dein Text wird zum Einfügen kopiert; nichts wird gesendet, bevor du das Formular absendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le formulaire est géré par un service externe. Le texte est copié pour que vous le colliez ; rien n’est envoyé avant que vous validiez le formulaire."
          }
        }
      }
    },
    "support.form.noticeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an external form?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Abrir un formulario externo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть внешнюю форму?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externes Formular öffnen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un formulaire externe ?"
          }
        }
      }
    },
    "support.form.returned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can’t see whether the form was submitted. If you didn’t submit it, your text is still copied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podemos saber si se envió el formulario. Si no lo enviaste, tu texto sigue copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не видим, была ли отправлена форма. Если вы её не отправили, текст всё ещё скопирован."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sehen nicht, ob das Formular gesendet wurde. Falls nicht, ist dein Text noch kopiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne pouvons pas savoir si le formulaire a été envoyé. Sinon, votre texte est toujours copié."
          }
        }
      }
    },
    "support.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what happened. The app prepares your message — you review and send it yourself in Mail or the web form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué pasó. La app prepara tu mensaje; tú lo revisas y lo envías en Mail o en el formulario web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите, что произошло. Приложение подготовит сообщение — вы проверите и отправите его сами в Почте или веб-форме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was passiert ist. Die App bereitet deine Nachricht vor – du prüfst und sendest sie selbst in Mail oder im Webformular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous ce qui s’est passé. L’app prépare votre message : vous le relisez et l’envoyez vous-même dans Mail ou le formulaire web."
          }
        }
      }
    },
    "support.mail.external": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mail app opened with the message. It’s sent only when you send it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu app de correo se abrió con el mensaje. Solo se envía cuando lo envías desde allí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почтовое приложение открыто с готовым письмом. Оно уйдёт, только когда вы отправите его там."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mail-App wurde mit der Nachricht geöffnet. Gesendet wird erst, wenn du sie dort sendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre app de messagerie s’est ouverte avec le message. Il n’est envoyé que lorsque vous l’envoyez depuis celle-ci."
          }
        }
      }
    },
    "support.mail.external.noScreenshot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mail app opened with the message. The screenshot couldn’t be attached — add it there if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu app de correo se abrió con el mensaje. No se pudo adjuntar la captura; añádela allí si hace falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почтовое приложение открыто с письмом. Скриншот приложить не удалось — добавьте его там при необходимости."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mail-App wurde mit der Nachricht geöffnet. Das Bildschirmfoto konnte nicht angehängt werden – füge es dort hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre app de messagerie s’est ouverte avec le message. La capture n’a pas pu être jointe : ajoutez-la si besoin."
          }
        }
      }
    },
    "support.mail.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail couldn’t prepare the message. Copy the text and send it from another app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo preparar el mensaje. Copia el texto y envíalo desde otra app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почта не смогла подготовить письмо. Скопируйте текст и отправьте из другого приложения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail konnte die Nachricht nicht vorbereiten. Kopiere den Text und sende ihn aus einer anderen App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas pu préparer le message. Copiez le texte et envoyez-le depuis une autre app."
          }
        }
      }
    },
    "support.mail.handedOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail accepted the message. Delivery depends on your mail account."
          }
