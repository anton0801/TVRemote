    "error.pair-003.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the code shown on the TV and enter it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el código que aparece en la TV e introdúcelo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте код на экране телевизора и введите его снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Code auf dem Fernseher und gib ihn erneut ein."
          }
        },
        "fr": {
