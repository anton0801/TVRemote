    "notifications.marketing.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Promotional notifications are sent only with this separate consent, at most about once a week. You can turn them off here at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones promocionales solo se envían con este consentimiento aparte, como mucho una vez por semana aprox. Puedes desactivarlas aquí cuando quieras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекламные уведомления приходят только с этим отдельным согласием, не чаще примерно раза в неделю. Отключить их можно здесь в любой момент."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbemitteilungen gibt es nur mit dieser separaten Einwilligung, höchstens etwa einmal pro Woche. Du kannst sie hier jederzeit abschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
