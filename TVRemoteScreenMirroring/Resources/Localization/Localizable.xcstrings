    "error.pair-004.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV no longer accepts this iPhone, for example after an update or reset. Pair it once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV ya no acepta este iPhone, por ejemplo tras una actualización o un restablecimiento. Vincúlala otra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор больше не принимает этот iPhone — например, после обновления или сброса. Подключите его ещё раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher akzeptiert dieses iPhone nicht mehr, z. B. nach einem Update oder Zurücksetzen. Kopple ihn erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur n’accepte plus cet iPhone, par exemple après une mise à jour ou une réinitialisation. Associez-le à nouveau."
          }
        }
      }
    },
    "error.pair-004.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair the TV again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a vincular la TV"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите телевизор заново"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernseher erneut koppeln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez à nouveau le téléviseur"
          }
        }
      }
    },
    "error.pair-005.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV uses a pairing method we can’t complete. Contact support with the TV model so we can check it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV usa un método de vinculación que no podemos completar. Contacta con soporte indicando el modelo para que lo revisemos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор использует способ сопряжения, который мы не можем завершить. Напишите в поддержку и укажите модель — мы проверим."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher nutzt ein Kopplungsverfahren, das wir nicht abschließen können. Nenne dem Support das Modell, damit wir es prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur utilise une méthode d’association que nous ne pouvons pas terminer. Contactez l’assistance en indiquant le modèle."
          }
        }
      }
    },
    "error.pair-005.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This TV model isn’t supported yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo de TV aún no es compatible"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель пока не поддерживается"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell wird noch nicht unterstützt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n’est pas encore pris en charge"
          }
        }
      }
    },
    "error.pair-006.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, pair again: the TV presented a different certificate than before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por seguridad, vuelve a vincularla: la TV presentó un certificado distinto al anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях безопасности подключите телевизор заново: он предъявил другой сертификат, чем раньше."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu deiner Sicherheit bitte neu koppeln: Der Fernseher hat ein anderes Zertifikat als zuvor gezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par sécurité, associez-le à nouveau : le téléviseur a présenté un certificat différent."
          }
        }
      }
    },
    "error.pair-006.title": {
