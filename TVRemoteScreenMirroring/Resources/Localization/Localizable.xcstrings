    "privacy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing keys are stored in the Keychain. A short list of technical states is kept for support; it’s only shared if you attach it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de vinculación se guardan en el llavero. Se guarda una breve lista de estados técnicos para soporte; solo se comparte si la adjuntas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи сопряжения хранятся в Связке ключей. Для поддержки хранится краткий список технических состояний — он передаётся, только если вы его приложите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplungsschlüssel liegen im Schlüsselbund. Eine kurze Liste technischer Zustände wird für den Support gespeichert und nur geteilt, wenn du sie anhängst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés d’association sont dans le trousseau. Une courte liste d’états techniques est conservée pour l’assistance ; elle n’est partagée que si vous la joignez."
          }
        }
      }
    },
