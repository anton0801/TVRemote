        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmé par Apple. Votre offre change au prochain renouvellement : voir la date ci-dessus."
          }
        }
      }
    },
    "change.yearly.syncing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple accepted the request; the new schedule is still syncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple aceptó la solicitud; el nuevo calendario aún se está sincronizando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple принял запрос; новое расписание ещё синхронизируется."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat die Anfrage angenommen; der neue Zeitplan wird noch abgeglichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a accepté la demande ; le nouveau calendrier se synchronise encore."
          }
        }
      }
    },
    "change.yearly.timing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple switches your plan at your next renewal. Your monthly access continues until then. No new free trial comes with the change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple cambia tu plan en la próxima renovación. Tu acceso mensual continúa hasta entonces. El cambio no incluye una nueva prueba gratuita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple сменит тариф при следующем продлении. До этого действует месячный доступ. Новый пробный период при смене не предоставляется."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple wechselt deinen Tarif bei der nächsten Verlängerung. Bis dahin läuft der Monatszugang weiter. Eine neue Testphase gibt es dabei nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple change votre offre au prochain renouvellement. Votre accès mensuel continue d’ici là. Aucun nouvel essai gratuit n’est inclus."
          }
        }
      }
    },
    "change.yearly.timingTrial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re in a free or discounted period. Apple decides how the change applies; remaining free days may not carry over. Check the date Apple confirms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en un periodo gratuito o con descuento. Apple decide cómo se aplica el cambio; los días gratis restantes pueden no conservarse. Revisa la fecha que confirme Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас бесплатный период или период со скидкой. Как применится смена, решает Apple; оставшиеся бесплатные дни могут не перенестись. Проверьте дату, которую подтвердит Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist in einem kostenlosen oder rabattierten Zeitraum. Apple entscheidet, wie der Wechsel gilt; übrige Gratistage werden eventuell nicht übernommen. Prüfe das von Apple bestätigte Datum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes en période gratuite ou à prix réduit. Apple décide de l’application du changement ; les jours gratuits restants peuvent ne pas être conservés. Vérifiez la date confirmée par Apple."
          }
        }
      }
    },
