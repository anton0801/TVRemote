    "privacy.crash.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crash reports (Firebase Crashlytics) contain technical codes only. A change takes full effect after the app restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes (Firebase Crashlytics) solo contienen códigos técnicos. El cambio se aplica por completo al reiniciar la app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчёты (Firebase Crashlytics) содержат только технические коды. Изменение полностью вступит в силу после перезапуска."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absturzberichte (Firebase Crashlytics) enthalten nur technische Codes. Die Änderung wirkt vollständig nach einem Neustart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports (Firebase Crashlytics) ne contiennent que des codes techniques. Le changement s’applique pleinement après redémarrage."
          }
        }
      }
    },
    "privacy.deletion.footer": {
      "extractionState": "manual",
      "localizations": {
