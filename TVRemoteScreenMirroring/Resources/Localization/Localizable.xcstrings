          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande a été refusée ou fermée sur le téléviseur. Réessayez et choisissez Autoriser à l’écran."
          }
        }
      }
    },
    "error.pair-001.title": {
