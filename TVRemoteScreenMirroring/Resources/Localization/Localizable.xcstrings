    "error.net-001.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TV Remote needs Local Network access to find and control your TV. Turn it on in Settings → TV Remote, then search again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TV Remote necesita acceso a la red local para encontrar y controlar tu TV. Actívalo en Ajustes → TV Remote y vuelve a buscar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TV Remote нужен доступ к локальной сети, чтобы найти телевизор и управлять им. Включите его в Настройках → TV Remote и повторите поиск."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TV Remote braucht Zugriff auf das lokale Netzwerk, um deinen Fernseher zu finden und zu steuern. Aktiviere ihn unter Einstellungen → TV Remote und suche erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV Remote a besoin de l’accès au réseau local pour trouver et contrôler votre téléviseur. Activez-le dans Réglages → TV Remote, puis relancez la recherche."
          }
        }
      }
    },
