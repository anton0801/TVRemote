    "remote.wake.notPermitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version can’t send the wake signal on your network. Turn the TV on with its own remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no puede enviar la señal en tu red. Enciende la TV con su mando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия не может отправить сигнал включения в вашей сети. Включите телевизор его пультом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version kann das Wecksignal in deinem Netzwerk nicht senden. Schalte den Fernseher mit seiner Fernbedienung ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne peut pas envoyer le signal sur votre réseau. Allumez le téléviseur avec sa télécommande."
          }
        }
      }
    },
    "remote.wake.sent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake signal sent. If the TV stays off, use its own remote — not every TV allows this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señal enviada. Si la TV sigue apagada, usa su propio mando: no todas lo permiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал отправлен. Если телевизор не включился, используйте его пульт — не все модели это поддерживают."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecksignal gesendet. Bleibt der Fernseher aus, nutze seine Fernbedienung – nicht jedes Gerät erlaubt das."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal envoyé. Si le téléviseur reste éteint, utilisez sa télécommande : tous ne le permettent pas."
          }
        }
      }
    },
    "remote.wake.unavailable": {
