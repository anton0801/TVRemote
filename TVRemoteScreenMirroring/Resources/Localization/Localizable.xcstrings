    "error.pair-001.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was declined or closed on the TV. Try again and choose Allow on the TV screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud se rechazó o se cerró en la TV. Inténtalo de nuevo y elige Permitir en la pantalla de la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос отклонён или закрыт на телевизоре. Повторите попытку и выберите «Разрешить» на экране телевизора."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
