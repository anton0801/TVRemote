    },
    "mirroring.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture only, no sound. Delay is noticeable, so it’s not meant for games. Many streaming apps block capture and show black."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo imagen, sin sonido. El retraso es perceptible, no está pensado para juegos. Muchas apps de streaming bloquean la captura y se ven en negro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только изображение, без звука. Задержка заметна, поэтому режим не для игр. Многие стриминговые приложения блокируют захват — будет чёрный экран."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Bild, kein Ton. Die Verzögerung ist spürbar, daher nicht für Spiele gedacht. Viele Streaming-Apps blockieren die Aufnahme und zeigen Schwarz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image seule, sans son. Le délai est perceptible : ce n’est pas prévu pour les jeux. Beaucoup d’apps de streaming bloquent la capture et affichent du noir."
          }
        }
      }
    },
    "mirroring.noAudio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound plays on the iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
