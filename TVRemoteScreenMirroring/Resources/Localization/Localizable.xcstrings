    "capability.note.appListIsCatalog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV doesn’t report installed apps, so a catalog of common services is shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV no informa de sus apps instaladas; se muestra un catálogo de servicios habituales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не сообщает установленные приложения — показан каталог популярных сервисов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fernseher meldet keine installierten Apps, daher wird ein Katalog bekannter Dienste gezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléviseur n’indique pas ses apps installées : un catalogue de services courants est affiché."
          }
        }
      }
    },
    "capability.note.holdNotSupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding a key repeats it instead of a long press."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsada una tecla la repite en lugar de una pulsación larga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание кнопки повторяет нажатие, а не делает долгое нажатие."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedrückthalten wiederholt die Taste statt eines langen Drucks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir une touche la répète au lieu d’un appui long."
          }
        }
      }
    },
    "capability.note.mediaRendererUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The media receiver didn’t respond."
          }
