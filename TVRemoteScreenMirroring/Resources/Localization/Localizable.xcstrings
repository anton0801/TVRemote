    "help.trialOffers.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The yearly plan includes a 3-day free trial for eligible customers. Apple decides eligibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan anual incluye 3 días de prueba gratuita para clientes aptos. Apple decide quién es apto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовой тариф включает 3 дня бесплатно для подходящих пользователей. Право на пробный период определяет Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Jahrestarif enthält 3 Tage Test für berechtigte Kunden. Apple entscheidet über die Berechtigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’offre annuelle inclut 3 jours d’essai pour les clients éligibles. Apple décide de l’éligibilité."
          }
        }
      }
    },
    "help.trialOffers.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next payment date is shown in Settings → Remote Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha del próximo pago aparece en Ajustes → Remote Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата следующего платежа указана в Настройках → Remote Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das nächste Zahlungsdatum steht unter Einstellungen → Remote Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du prochain paiement figure dans Réglages → Remote Pro."
          }
        }
      }
    },
    "help.trialOffers.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To avoid being charged, cancel at least 24 hours before a free period ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar el cobro, cancela al menos 24 horas antes de que termine el periodo gratuito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы избежать списания, отмените не позднее чем за 24 часа до конца бесплатного периода."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine Abbuchung zu vermeiden, kündige mindestens 24 Stunden vor Ende des Gratiszeitraums."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour éviter d’être facturé, annulez au moins 24 heures avant la fin de la période gratuite."
          }
        }
      }
    },
    "help.trialOffers.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonus discounts apply to the first month only; renewals are at the standard price."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los descuentos de bonos solo se aplican al primer mes; las renovaciones son al precio estándar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонусные скидки действуют только на первый месяц; продления — по стандартной цене."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonusrabatte gelten nur im ersten Monat; Verlängerungen kosten den Standardpreis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réductions bonus ne valent que pour le premier mois ; les renouvellements sont au prix standard."
          }
        }
      }
    },
    "help.trialOffers.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free trial, discounts and next payment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratuita, descuentos y próximo pago"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период, скидки и следующий платёж"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testphase, Rabatte und nächste Zahlung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit, réductions et prochain paiement"
          }
        }
      }
    },
    "help.tvNotFound.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app finds TVs on your home network. These steps solve most search problems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app busca TV en tu red doméstica. Estos pasos resuelven la mayoría de los problemas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение ищет телевизоры в домашней сети. Эти шаги решают большинство проблем с поиском."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App sucht Fernseher in deinem Heimnetz. Diese Schritte lösen die meisten Suchprobleme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app recherche les téléviseurs sur votre réseau domestique. Ces étapes règlent la plupart des problèmes."
          }
        }
      }
    },
    "help.tvNotFound.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the TV on. A TV that is fully off usually isn’t visible on the network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende la TV. Una TV totalmente apagada no suele verse en la red."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите телевизор. Полностью выключенный телевизор обычно не виден в сети."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Fernseher ein. Ein ganz ausgeschalteter Fernseher ist meist nicht im Netzwerk sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez le téléviseur. Un téléviseur complètement éteint n’est généralement pas visible sur le réseau."
          }
        }
      }
    },
    "help.tvNotFound.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the iPhone and TV use the same Wi‑Fi network (the TV can also be on Ethernet on the same router)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el iPhone y la TV usen la misma red Wi‑Fi (la TV también puede ir por cable al mismo router)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что iPhone и телевизор в одной сети Wi‑Fi (телевизор может быть подключён кабелем к тому же роутеру)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob iPhone und Fernseher dasselbe WLAN nutzen (der Fernseher kann auch per Kabel am selben Router hängen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que l’iPhone et le téléviseur utilisent le même réseau Wi‑Fi (le téléviseur peut aussi être en Ethernet sur le même routeur)."
          }
        }
      }
    },
    "help.tvNotFound.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Local Network: Settings → TV Remote → Local Network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la red local: Ajustes → TV Remote → Red local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ: Настройки → TV Remote → Локальная сеть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Netzwerk erlauben: Einstellungen → TV Remote → Lokales Netzwerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le réseau local : Réglages → TV Remote → Réseau local."
          }
        }
      }
    },
    "help.tvNotFound.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guest networks and “client isolation” on routers hide devices from each other. Use your main network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las redes de invitados y el «aislamiento de clientes» del router ocultan los dispositivos entre sí. Usa tu red principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гостевые сети и «изоляция клиентов» на роутере скрывают устройства друг от друга. Используйте основную сеть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastnetze und „Client-Isolation“ am Router verbergen Geräte voreinander. Nutze dein Hauptnetz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réseaux invités et « l’isolation des clients » du routeur masquent les appareils. Utilisez votre réseau principal."
          }
        }
      }
    },
    "help.tvNotFound.step5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off VPN on the iPhone while searching, then search again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la VPN del iPhone mientras buscas y vuelve a buscar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите VPN на iPhone на время поиска и повторите поиск."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere während der Suche das VPN auf dem iPhone und suche erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez le VPN de l’iPhone pendant la recherche, puis relancez-la."
          }
        }
      }
    },
    "help.tvNotFound.title": {
      "extractionState": "manual",
      "localizations": {
