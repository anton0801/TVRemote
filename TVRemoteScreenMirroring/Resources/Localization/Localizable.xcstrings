    "error.med-003.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected item couldn’t be read. It may have been deleted or access was removed. Choose it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el elemento. Puede que se haya eliminado o se haya retirado el acceso. Vuelve a elegirlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать выбранный файл. Возможно, он удалён или доступ отозван. Выберите его снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gewählte Objekt konnte nicht gelesen werden. Es wurde eventuell gelöscht oder der Zugriff entzogen. Wähle es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément choisi n’a pas pu être lu. Il a peut-être été supprimé ou l’accès retiré. Choisissez-le à nouveau."
          }
        }
      }
    },
    "error.med-003.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load the file"
          }
        },
        "es": {
