      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your router gave the TV a new address. Search again — your saved settings and favorites are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El router asignó una nueva dirección a la TV. Vuelve a buscar: tus ajustes y favoritos se conservan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роутер выдал телевизору новый адрес. Повторите поиск — сохранённые настройки и избранное останутся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Router hat dem Fernseher eine neue Adresse gegeben. Suche erneut – Einstellungen und Favoriten bleiben erhalten."
