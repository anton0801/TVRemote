    "capability.note.airPlayAvailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This TV advertises AirPlay: iPhone’s own Screen Mirroring from Control Center may work, free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta TV anuncia AirPlay: la duplicación propia del iPhone desde el Centro de control puede funcionar, gratis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор поддерживает AirPlay: может работать встроенный «Повтор экрана» iPhone из Пункта управления — бесплатно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Fernseher meldet AirPlay: Die eigene Bildschirmsynchronisierung des iPhone im Kontrollzentrum kann kostenlos funktionieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléviseur annonce AirPlay : la Recopie de l’écran intégrée à l’iPhone peut fonctionner gratuitement."
          }
        }
      }
    },
    "capability.note.appLaunchUnconfirmed": {
      "extractionState": "manual",
      "localizations": {
