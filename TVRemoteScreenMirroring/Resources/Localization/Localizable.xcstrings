    "help.buttonsNotWorking.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which buttons work depends on the TV model and what the TV is showing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones que funcionan dependen del modelo de TV y de lo que muestre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие кнопки работают, зависит от модели телевизора и того, что на нём открыто."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Tasten funktionieren, hängt vom Modell und vom aktuellen Bildschirm ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches disponibles dépendent du modèle et de ce qu’affiche le téléviseur."
          }
        }
      }
    },
    "help.buttonsNotWorking.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grey buttons aren’t offered by this TV’s protocol. Other buttons still work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones grises no los ofrece el protocolo de esta TV. Los demás siguen funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серые кнопки не поддерживаются протоколом этого телевизора. Остальные работают."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Graue Tasten bietet das Protokoll dieses Fernsehers nicht. Die anderen funktionieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches grisées ne sont pas proposées par le protocole de ce téléviseur. Les autres fonctionnent."
          }
        }
      }
    },
    "help.buttonsNotWorking.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If volume doesn’t change, sound may go to a soundbar or receiver — use its own remote for volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el volumen no cambia, el sonido puede ir a una barra de sonido o un receptor: usa su mando para el volumen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если громкость не меняется, звук может идти на саундбар или ресивер — регулируйте громкость его пультом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert sich die Lautstärke nicht, läuft der Ton eventuell über Soundbar oder Receiver – nutze deren Fernbedienung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le volume ne change pas, le son passe peut-être par une barre de son ou un ampli : utilisez sa télécommande."
          }
        }
      }
    },
    "help.buttonsNotWorking.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most TVs can’t be turned on over Wi‑Fi once fully off. Use the TV’s own remote to turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de las TV no se pueden encender por Wi‑Fi si están apagadas del todo. Usa su propio mando para encenderla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство телевизоров нельзя включить по Wi‑Fi, если они полностью выключены. Включите телевизор его пультом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Fernseher lassen sich ganz ausgeschaltet nicht per WLAN einschalten. Nutze dafür die TV-Fernbedienung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des téléviseurs ne s’allument pas via Wi‑Fi une fois complètement éteints. Utilisez leur télécommande."
          }
        }
      }
    },
    "help.buttonsNotWorking.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A button press shows feedback on the phone immediately; the TV may react a moment later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pulsar un botón verás la respuesta en el teléfono al instante; la TV puede reaccionar un poco después."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие сразу отображается на телефоне, а телевизор может отреагировать чуть позже."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tastendruck zeigt sofort Feedback am Telefon; der Fernseher reagiert eventuell etwas später."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui s’affiche aussitôt sur le téléphone ; le téléviseur peut réagir un instant plus tard."
          }
        }
      }
    },
    "help.buttonsNotWorking.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons, volume or power don’t work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones, el volumen o el encendido no funcionan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не работают кнопки, громкость или питание"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten, Lautstärke oder Ein/Aus gehen nicht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches, volume ou marche ne fonctionnent pas"
          }
        }
      }
    },
    "help.cannotConnect.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first connection must be allowed on the TV itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera conexión debe permitirse en la propia TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое подключение нужно разрешить на самом телевизоре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Verbindung muss am Fernseher selbst erlaubt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première connexion doit être autorisée sur le téléviseur lui-même."
          }
        }
      }
    },
    "help.cannotConnect.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the TV remote nearby. Choose Allow on the TV when asked, or enter the code shown on the TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten el mando de la TV a mano. Elige Permitir cuando la TV lo pida o introduce el código que muestre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите пульт телевизора рядом. Выберите «Разрешить» на ТВ или введите показанный код."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die TV-Fernbedienung bereit. Wähle am Fernseher „Zulassen“ oder gib den angezeigten Code ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la télécommande du téléviseur à portée. Choisissez Autoriser ou saisissez le code affiché."
          }
        }
      }
    },
    "help.cannotConnect.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you declined by mistake, check the TV’s device connection settings (e.g. “Device Connection Manager” on Samsung) and allow TV Remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo rechazaste por error, revisa los ajustes de conexión de dispositivos de la TV (p. ej. «Administrador de conexión de dispositivos» en Samsung) y permite TV Remote."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы случайно отклонили запрос, проверьте в настройках ТВ список подключаемых устройств (например, «Диспетчер подключения устройств» у Samsung) и разрешите TV Remote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls du versehentlich abgelehnt hast, prüfe die Geräteverbindungs-Einstellungen am Fernseher (z. B. „Geräteverbindungs-Manager“ bei Samsung) und erlaube TV Remote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez refusé par erreur, vérifiez les réglages de connexion des appareils du téléviseur (par ex. « Gestionnaire de connexion » sur Samsung) et autorisez TV Remote."
          }
        }
      }
    },
    "help.cannotConnect.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a TV update or reset, pair again: Settings → Saved TVs → Forget, then connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras actualizar o restablecer la TV, vuelve a vincularla: Ajustes → TV guardadas → Olvidar y conecta de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После обновления или сброса ТВ подключите его заново: Настройки → Сохранённые ТВ → Забыть, затем подключите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Update oder Zurücksetzen neu koppeln: Einstellungen → Gespeicherte Fernseher → Vergessen, dann verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une mise à jour ou réinitialisation, associez à nouveau : Réglages → Téléviseurs enregistrés → Oublier, puis connectez."
          }
        }
      }
    },
    "help.cannotConnect.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the TV and your router if the connection keeps dropping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia la TV y el router si la conexión se sigue cortando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагрузите телевизор и роутер, если соединение продолжает обрываться."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Fernseher und Router neu, wenn die Verbindung immer wieder abbricht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez le téléviseur et le routeur si la connexion continue de se couper."
          }
        }
      }
    },
    "help.cannotConnect.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t connect or pair"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar o vincular"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся подключиться"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden oder Koppeln klappt nicht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion ou association impossible"
          }
        }
      }
    },
    "help.changePlan.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan changes follow Apple’s rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de plan siguen las reglas de Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена тарифа происходит по правилам Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarifwechsel folgen den Regeln von Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements d’offre suivent les règles d’Apple."
          }
        }
      }
    },
    "help.changePlan.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly → yearly: the yearly plan starts at your next renewal; monthly access continues until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensual → anual: el plan anual empieza en la próxima renovación; el acceso mensual continúa hasta entonces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц → год: годовой тариф начнётся при следующем продлении, до этого действует месячный."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatlich → jährlich: Der Jahrestarif beginnt bei der nächsten Verlängerung; bis dahin gilt der Monatszugang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensuel → annuel : l’annuel commence au prochain renouvellement ; l’accès mensuel continue d’ici là."
          }
        }
      }
    },
    "help.changePlan.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime is a separate one-time purchase. It doesn’t cancel your subscription — turn off auto-renew yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de por vida es un pago único aparte. No cancela tu suscripción: desactiva tú la renovación."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ навсегда — отдельная разовая покупка. Он не отменяет подписку — отключите автопродление сами."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauerhafter Zugriff ist ein separater Einmalkauf. Er kündigt dein Abo nicht – deaktiviere die Verlängerung selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à vie est un achat unique distinct. Il n’annule pas l’abonnement : désactivez vous-même le renouvellement."
          }
        }
      }
    },
    "help.changePlan.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To cancel, open Manage subscription and turn off auto-renew. Access continues until the end of the paid period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cancelar, abre Gestionar suscripción y desactiva la renovación. El acceso sigue hasta el final del periodo pagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отменить, откройте «Управлять подпиской» и выключите автопродление. Доступ сохранится до конца оплаченного периода."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Kündigen öffne „Abo verwalten“ und deaktiviere die Verlängerung. Der Zugriff bleibt bis Ende der bezahlten Periode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour résilier, ouvrez Gérer l’abonnement et désactivez le renouvellement. L’accès continue jusqu’à la fin de la période payée."
          }
        }
      }
    },
    "help.changePlan.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TVs, favorites and settings are kept when access ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus TV, favoritos y ajustes se conservan cuando termina el acceso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизоры, избранное и настройки сохраняются после окончания доступа."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernseher, Favoriten und Einstellungen bleiben nach Ende des Zugriffs erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos téléviseurs, favoris et réglages sont conservés à la fin de l’accès."
          }
        }
      }
    },
    "help.changePlan.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change plan, cancel or go lifetime"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar plan, cancelar o pasar a de por vida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сменить тариф, отменить или купить навсегда"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarif wechseln, kündigen oder dauerhaft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer d’offre, résilier ou passer à vie"
          }
        }
      }
    },
    "help.contact": {
