    "apps.catalog.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV doesn’t report installed apps. These are common services — they open only if installed on the TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu TV no informa de sus apps. Son servicios habituales: solo se abren si están instalados en la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не сообщает установленные приложения. Это популярные сервисы — они откроются, только если установлены на ТВ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fernseher meldet keine installierten Apps. Das sind gängige Dienste – sie öffnen sich nur, wenn sie installiert sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléviseur n’indique pas ses apps. Ce sont des services courants : ils s’ouvrent seulement s’ils sont installés."
          }
        }
      }
    },
    "apps.catalogNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalog shortcuts open only if the app is installed on the TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los accesos del catálogo solo se abren si la app está instalada en la TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ярлыки каталога откроются, только если приложение установлено на ТВ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog-Verknüpfungen öffnen sich nur, wenn die App installiert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis du catalogue s’ouvrent seulement si l’app est installée."
          }
        }
      }
    },
