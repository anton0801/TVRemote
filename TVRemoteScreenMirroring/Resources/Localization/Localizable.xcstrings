    "support.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support contacts aren’t set up in this build yet. You can copy your message and use the Help Center."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contactos de soporte aún no están configurados en esta versión. Puedes copiar tu mensaje y usar el Centro de ayuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакты поддержки в этой сборке ещё не настроены. Вы можете скопировать сообщение и воспользоваться справкой."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Support-Kontakte sind in dieser Version noch nicht eingerichtet. Du kannst deine Nachricht kopieren und die Hilfe nutzen."
          }
        },
        "fr": {
