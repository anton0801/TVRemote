    "bonus.terms.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers are activated through Apple and apply only if Apple’s conditions are met. Discounts apply to the first month only; subscriptions then renew at the standard price until canceled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ofertas se activan a través de Apple y solo se aplican si se cumplen sus condiciones. Los descuentos son solo para el primer mes; después la suscripción se renueva al precio estándar hasta que canceles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложения активируются через Apple и действуют только при выполнении условий Apple. Скидки — только на первый месяц; затем подписка продлевается по стандартной цене до отмены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angebote werden über Apple aktiviert und gelten nur, wenn Apples Bedingungen erfüllt sind. Rabatte gelten nur im ersten Monat; danach verlängert sich das Abo zum Standardpreis bis zur Kündigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les offres s’activent via Apple et ne s’appliquent que si les conditions d’Apple sont remplies. Les réductions ne valent que pour le premier mois ; l’abonnement se renouvelle ensuite au prix standard jusqu’à résiliation."
          }
        }
      }
    },
    "bonus.title": {
