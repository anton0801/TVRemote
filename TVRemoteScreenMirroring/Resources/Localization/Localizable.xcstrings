    "welcome.pricingNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to download and to check your TV. Continued use needs Remote Pro (monthly, yearly or one‑time purchase) — no ads, no account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga y comprobación de tu TV gratis. Para seguir usándolo necesitas Remote Pro (mensual, anual o pago único), sin anuncios ni cuenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивание и проверка телевизора бесплатны. Для дальнейшего использования нужен Remote Pro (месяц, год или разовая покупка) — без рекламы и регистрации."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download und TV-Check sind kostenlos. Für die weitere Nutzung brauchst du Remote Pro (monatlich, jährlich oder einmalig) – ohne Werbung, ohne Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement et vérification du téléviseur gratuits. L’utilisation continue nécessite Remote Pro (mensuel, annuel ou achat unique), sans pub ni compte."
          }
        }
      }
