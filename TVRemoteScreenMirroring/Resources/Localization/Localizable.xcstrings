    "change.lifetime.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same features, no recurring payments. Earlier payments aren’t deducted from the price."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismas funciones, sin pagos recurrentes. Los pagos anteriores no se descuentan del precio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Те же функции без регулярных платежей. Прошлые платежи не вычитаются из цены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Funktionen, keine wiederkehrenden Zahlungen. Frühere Zahlungen werden nicht angerechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mêmes fonctions, sans paiement récurrent. Les paiements antérieurs ne sont pas déduits du prix."
          }
        }
      }
    },
    "change.lifetime.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime access is active. Remember to manage your existing subscription if you don’t want it to renew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de por vida está activo. Recuerda gestionar tu suscripción actual si no quieres que se renueve."
