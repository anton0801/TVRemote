    "paywall.terms.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple Account when you confirm. Subscriptions renew automatically unless canceled at least 24 hours before the end of the current period or free trial. Manage or cancel them in your Apple subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu cuenta de Apple al confirmar. Las suscripciones se renuevan automáticamente salvo que las canceles al menos 24 horas antes del final del periodo actual o de la prueba gratuita. Gestiónalas o cancélalas en tus suscripciones de Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списывается с Apple Account при подтверждении. Подписка продлевается автоматически, если не отменить её минимум за 24 часа до конца текущего или пробного периода. Управлять подпиской и отменить её можно в подписках Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird bei Bestätigung deinem Apple Account belastet. Abos verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums oder Tests gekündigt werden. Verwalten oder kündigen kannst du sie in deinen Apple-Abos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de votre compte Apple à la confirmation. Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 heures avant la fin de la période en cours ou de l’essai gratuit. Gérez-les ou résiliez-les dans vos abonnements Apple."
          }
        }
      }
    },
