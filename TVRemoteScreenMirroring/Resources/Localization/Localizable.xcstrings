    "header.switch.mirroring.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing on the current TV will stop before switching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido en la TV actual se detendrá antes de cambiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ на текущем телевизоре будет остановлен перед переключением."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe auf dem aktuellen Fernseher wird vor dem Wechsel beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’affichage sur le téléviseur actuel s’arrêtera avant le changement."
          }
        }
      }
    },
