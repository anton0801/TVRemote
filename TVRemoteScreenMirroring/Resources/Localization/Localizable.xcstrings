    "compat.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each feature is checked separately on your TV. A working remote doesn’t mean every other feature works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada función se comprueba por separado en tu TV. Que el mando funcione no implica que funcione todo lo demás."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая функция проверяется отдельно. Работающий пульт не означает, что работают все остальные функции."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Funktion wird einzeln an deinem Fernseher geprüft. Eine funktionierende Fernbedienung heißt nicht, dass alles andere funktioniert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fonction est vérifiée séparément. Une télécommande qui fonctionne ne signifie pas que tout le reste fonctionne."
          }
        }
      }
    },
