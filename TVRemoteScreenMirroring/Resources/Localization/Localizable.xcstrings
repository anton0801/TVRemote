    "remote.touchpad.accessibilityHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to move. Double-tap to select. The Buttons layout offers all directions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza arriba o abajo para moverte. Toca dos veces para seleccionar. El diseño Botones ofrece todas las direcciones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вверх или вниз для перемещения. Дважды коснитесь для выбора. В режиме «Кнопки» доступны все направления."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben oder unten wischen zum Bewegen. Doppeltippen zum Auswählen. Das Tasten-Layout bietet alle Richtungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le haut ou le bas pour vous déplacer. Touchez deux fois pour sélectionner. La disposition Touches offre toutes les directions."
          }
        }
      }
    },
