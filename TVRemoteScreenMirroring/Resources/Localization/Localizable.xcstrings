    "mirroring.privacyWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything on your iPhone screen may appear on the TV, including notifications and personal content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que aparezca en la pantalla del iPhone puede verse en la TV, incluidas notificaciones y contenido personal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что на экране iPhone, может появиться на телевизоре, включая уведомления и личные данные."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles auf deinem iPhone-Bildschirm kann auf dem Fernseher erscheinen, auch Mitteilungen und persönliche Inhalte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui s’affiche sur l’iPhone peut apparaître sur le téléviseur, y compris les notifications et le contenu personnel."
          }
        }
      }
    },
