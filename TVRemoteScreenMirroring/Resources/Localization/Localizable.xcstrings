      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing isn’t supported here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no se puede escribir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь нельзя вводить текст"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen wird hier nicht unterstützt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie n’est pas prise en charge ici"
          }
        }
      }
    },
    "error.txt-003.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the TV. If the text is missing, send it again — we don’t resend automatically to avoid duplicates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la TV. Si falta el texto, envíalo de nuevo; no lo reenviamos automáticamente para evitar duplicados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте телевизор. Если текста нет, отправьте его снова — мы не повторяем отправку сами, чтобы не было дублей."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Fernseher. Fehlt der Text, sende ihn erneut – wir senden nicht automatisch nach, um Doppelungen zu vermeiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le téléviseur. Si le texte manque, renvoyez-le : nous ne le renvoyons pas automatiquement pour éviter les doublons."
          }
        }
      }
    },
    "error.txt-003.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure the text arrived"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sabe si llegó el texto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестно, дошёл ли текст"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unklar, ob der Text angekommen ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer l’envoi du texte"
          }
        }
      }
    },
    "explain.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find my TV"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar mi TV"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найти телевизор"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernseher suchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouver mon téléviseur"
          }
        }
      }
    },
    "explain.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will ask for Local Network access. It’s needed to find the TV and send commands to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pedirá acceso a la red local. Es necesario para encontrar la TV y enviarle órdenes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS запросит доступ к локальной сети. Он нужен, чтобы найти телевизор и отправлять ему команды."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt nach Zugriff auf das lokale Netzwerk. Er wird gebraucht, um den Fernseher zu finden und zu steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demandera l’accès au réseau local. Il sert à trouver le téléviseur et à lui envoyer des commandes."
          }
        }
      }
    },
    "explain.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands, photos and your screen go directly to your TV on your home network — not to our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las órdenes, fotos y tu pantalla van directamente a la TV por tu red doméstica, no a nuestros servidores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды, фото и изображение экрана идут напрямую на телевизор через домашнюю сеть, а не на наши серверы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle, Fotos und dein Bildschirm gehen direkt über dein Heimnetz an den Fernseher – nicht an unsere Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes, photos et votre écran vont directement au téléviseur via votre réseau domestique, pas vers nos serveurs."
          }
        }
      }
    },
    "explain.sameNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone and TV must be on the same Wi‑Fi network. Any band works as long as the devices can reach each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone y la TV deben estar en la misma red Wi‑Fi. Sirve cualquier banda si los dispositivos se ven entre sí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone и телевизор должны быть в одной сети Wi‑Fi. Частота не важна, если устройства видят друг друга."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone und Fernseher müssen im selben WLAN sein. Jedes Frequenzband geht, solange sich die Geräte erreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone et le téléviseur doivent être sur le même réseau Wi‑Fi. N’importe quelle bande convient si les appareils se voient."
          }
        }
      }
    },
    "explain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before we look for your TV"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de buscar tu TV"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед поиском телевизора"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor wir deinen Fernseher suchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de rechercher votre téléviseur"
          }
        }
      }
    },
    "explain.tvOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the TV on. A TV that is fully off usually can’t be found over the network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende la TV. Una TV totalmente apagada normalmente no se puede encontrar por la red."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите телевизор. Полностью выключенный телевизор обычно не виден в сети."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Fernseher ein. Ein ganz ausgeschalteter Fernseher ist im Netzwerk meist nicht auffindbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez le téléviseur. Un téléviseur complètement éteint est généralement introuvable sur le réseau."
          }
        }
      }
    },
    "freeCheck.lessThanMinute": {
