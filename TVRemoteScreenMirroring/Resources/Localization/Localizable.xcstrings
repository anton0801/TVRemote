            "state": "translated",
            "value": "No se pudo cargar el archivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить файл"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht geladen werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le fichier"
          }
        }
      }
    },
    "error.med-004.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original is stored in iCloud and couldn’t be downloaded. Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original está en iCloud y no se pudo descargar. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал хранится в iCloud и не загрузился. Проверьте подключение к интернету и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original liegt in iCloud und konnte nicht geladen werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’original est dans iCloud et n’a pas pu être téléchargé. Vérifiez votre connexion Internet et réessayez."
          }
        }
      }
    },
    "error.med-004.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud download failed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al descargar de iCloud"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить из iCloud"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download aus iCloud fehlgeschlagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement depuis iCloud"
          }
        }
      }
    },
    "error.med-005.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing this video needs free space on your iPhone. Free up some space or choose a shorter video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparar este vídeo requiere espacio libre en el iPhone. Libera espacio o elige un vídeo más corto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для подготовки видео нужно свободное место на iPhone. Освободите место или выберите видео короче."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Vorbereiten des Videos wird freier Speicher benötigt. Schaffe Platz oder wähle ein kürzeres Video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La préparation de cette vidéo nécessite de l’espace libre. Libérez de l’espace ou choisissez une vidéo plus courte."
          }
        }
      }
    },
    "error.med-005.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
