    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Fernseher in deinem WLAN und sendet Befehle, Fotos und deinen Bildschirm an den gewählten Fernseher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds TVs on your Wi‑Fi network and sends remote commands, photos and your screen to the TV you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca TV en tu red Wi‑Fi y envía órdenes, fotos y tu pantalla a la TV que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les téléviseurs sur votre réseau Wi‑Fi et envoie commandes, photos et votre écran au téléviseur choisi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находит телевизоры в вашей сети Wi‑Fi и передаёт команды, фото и изображение экрана на выбранный телевизор."
          }
        }
      }
    }
